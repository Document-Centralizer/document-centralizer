# ==========================================
# Database Configuration
# ==========================================
DB_PASSWORD=your_secure_db_password

# ==========================================
# AWS Configuration (Required for S3 Storage)
# ==========================================
# IMPORTANT: Never commit actual AWS keys to GitHub! 
# The production server must have these exact variable names configured in its environment.

AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_production_bucket_name
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key
